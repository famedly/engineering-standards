{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended",
		"schedule:earlyMondays",
		"schedule:automergeEarlyMondays"
	],
	"timezone": "Europe/Vienna",
	"enabledManagers": ["nix"],
	"nix": {
		"enabled": true
	},
	"lockFileMaintenance": {
		"enabled": true,
		"schedule": "before 4am"
	}
}
